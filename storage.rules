rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Community infrastructure report attachments
    match /communityReports/{reportId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

